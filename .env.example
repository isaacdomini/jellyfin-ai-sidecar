# ==============================================================================
# Jellyfin AI Sidecar - Scoped Environment Configuration
# (Safe for shared .env files across multiple docker-compose services)
# ==============================================================================

# Application Image & Ports
AI_SIDECAR_IMAGE_TAG=latest
AI_SIDECAR_PORT=8000
AI_SIDECAR_DEBUG=false

# Media Library Path (host path mounted into containers)
AI_SIDECAR_MEDIA_PATH=/mnt/data/jellyfin

# Database Configuration (PostgreSQL + pgvector)
AI_SIDECAR_DB_USER=jellyfin_user
AI_SIDECAR_DB_PASSWORD=your_secure_ai_db_password
AI_SIDECAR_DB_NAME=jellyfin_ai
AI_SIDECAR_DB_PORT=5432
AI_SIDECAR_DB_HOST=ai-db
# AI_SIDECAR_DATABASE_URL=postgresql://jellyfin_user:your_secure_ai_db_password@ai-db:5432/jellyfin_ai

# Subtitle Chunker & Vector Embedding Settings
AI_SIDECAR_CHUNK_SIZE_SECONDS=30
AI_SIDECAR_CHUNK_OVERLAP_SECONDS=5
AI_SIDECAR_EMBEDDING_DIMENSION=768

# ==============================================================================
# LLM & RAG Configuration
# ==============================================================================
# Supported providers: openai, gemini, anthropic, groq, ollama, custom, mock
AI_SIDECAR_LLM_PROVIDER=openai

# LLM API Key (required for OpenAI, Gemini, Anthropic, Groq; optional for Ollama)
AI_SIDECAR_LLM_API_KEY=sk-proj-your-api-key-here

# Default Model name (e.g. gpt-4o-mini, gemini-2.0-flash, claude-3-5-haiku-20241022, llama-3.3-70b-versatile, llama3.2)
AI_SIDECAR_LLM_MODEL=gpt-4o-mini

# Custom Base URL (e.g. http://localhost:11434/v1 for Ollama, https://openrouter.ai/api/v1 for OpenRouter)
AI_SIDECAR_LLM_BASE_URL=

# RAG Context & Generation Settings
AI_SIDECAR_RAG_TOP_K=5
AI_SIDECAR_LLM_TEMPERATURE=0.2

# Jellyfin Connection (Optional)
AI_SIDECAR_JELLYFIN_SERVER_URL=https://jellyfin.isaacdomini.com
AI_SIDECAR_JELLYFIN_API_KEY=
AI_SIDECAR_JELLYFIN_WEBHOOK_SECRET=


