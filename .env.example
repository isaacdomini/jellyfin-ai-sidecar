# ==========================================
# Jellyfin AI Sidecar - Environment Config
# ==========================================

# Docker Image Tag (optional override, default: latest)
IMAGE_TAG=latest

# Application Ports
APP_PORT=8000
DB_PORT=5432

# Application Settings
DEBUG=false
APP_NAME=jellyfin-ai-sidecar

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=jellyfin_user
POSTGRES_PASSWORD=jellyfin_pass
POSTGRES_DB=jellyfin_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://jellyfin_user:jellyfin_pass@db:5432/jellyfin_ai

# Subtitle Chunker Settings
CHUNK_SIZE_SECONDS=30
CHUNK_OVERLAP_SECONDS=5

# Vector Embedding Settings
EMBEDDING_DIMENSION=768

# Media Path (Mount your Jellyfin media library directory into Docker)
MEDIA_PATH=/path/to/your/jellyfin/media

# Jellyfin Integration (Optional)
JELLYFIN_SERVER_URL=http://localhost:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
JELLYFIN_WEBHOOK_SECRET=

# ==========================================
# LLM & RAG Configuration
# ==========================================
# Supported providers: openai, gemini, anthropic, groq, ollama, custom, mock
LLM_PROVIDER=openai

# LLM API Key (required for OpenAI, Gemini, Anthropic, Groq; optional for Ollama)
LLM_API_KEY=sk-proj-your-api-key-here

# Default Model name (e.g. gpt-4o-mini, gemini-2.0-flash, claude-3-5-haiku-20241022, llama-3.3-70b-versatile, llama3.2)
LLM_MODEL=gpt-4o-mini

# Custom Base URL (required for Ollama e.g. http://localhost:11434/v1, OpenRouter https://openrouter.ai/api/v1, or local vLLM)
LLM_BASE_URL=

# RAG context configuration
RAG_TOP_K=5
LLM_TEMPERATURE=0.2

